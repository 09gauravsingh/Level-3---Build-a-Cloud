//This file is the Grafana Alloy log collection pipeline for Kubernetes.(core Alloy pipeline)
// Discover Kubernetes Pods.

// Find Pods
//    ↓
// add useful Kubernetes labels
//    ↓
// read their logs
//    ↓
// send those logs to Loki

//Grafana's current documentation recommends Alloy for collecting Kubernetes logs and 
//forwarding them through loki.write to Loki. loki.source.kubernetes can collect Pod logs 
//using the Kubernetes API without privileged host filesystem access.

// Discover Pods only on this Alloy Pod's node.
discovery.kubernetes "pods" {
  role = "pod"

  selectors {
    role  = "pod"
    field = "spec.nodeName=" + coalesce(sys.env("HOSTNAME"), constants.hostname)
  }
}

// Add useful Kubernetes labels.
discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets

  // Namespace
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  // Pod
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  // Container
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  // Application label
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "app"
  }

  // CloudNativePG cluster name.
  // Used for per-instance PostgreSQL logs.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_cnpg_io_cluster"]
    target_label  = "instance"
  }
}


// Read logs from Kubernetes Pods.
loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.write.loki.receiver]
}


// Send logs to our internal Loki gateway.
loki.write "loki" {
  endpoint {
    url = "http://loki-gateway.logging.svc.cluster.local/loki/api/v1/push"
  }
}