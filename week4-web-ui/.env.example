# The app calls same-origin paths (/api/v1/...) by default, which is what you
# want in production behind an Ingress. Leave both values unset unless you have
# a reason to override them.

# Where the dev server proxies /api during `npm run dev`.
VITE_DEV_API_TARGET=http://localhost:8080

# Absolute API origin, e.g. https://api.example.com. Setting this makes the
# browser call the API cross-origin, so that origin must be in the API's CORS
# allowlist (see week3-paas-api/internal/api/routes.go).
# VITE_API_BASE_URL=
